    <worksheet name='Spend Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#14213d' fontsize='13'>Where did the money go?</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#2a9d8f' fontsize='9'>fuel</run>
            <run bold='true' fontcolor='#8a94a3' fontsize='9'> vs. </run>
            <run bold='true' fontcolor='#e8a33d' fontsize='9'>maintenance</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='v_fleet_activity (fleet_management)' name='federated.0ieta591od6l6310zs0tm09nx7go' />
