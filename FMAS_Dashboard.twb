    <worksheet name='Weekly Rhythm'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='13'>Which days are the busiest?</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#8a94a3' fontsize='9'>Miles driven per day (darker =  more miles)</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='v_fleet_activity (fleet_management)' name='federated.0ieta591od6l6310zs0tm09nx7go' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Window' datatype='string' name='[Parameter 0860095027589120]' param-domain-type='list' role='measure' type='nominal' value='&quot;Last 30 days&quot;'>
              <calculation class='tableau' formula='&quot;Last 30 days&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ieta591od6l6310zs0tm09nx7go'>
            <column caption='Latest Date' datatype='date' name='[Calculation_0860095029850115]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX([event_date]) }' />
            </column>
            <column caption='In window' datatype='boolean' name='[Calculation_0860095030267908]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 0860095027589120]&#13;&#10;WHEN &apos;Latest day&apos; THEN [event_date] = [Calculation_0860095029850115]&#13;&#10;WHEN &apos;Last 7 days&apos; THEN [event_date] &gt; DATEADD(&apos;day&apos;, -7, [Calculation_0860095029850115])&#13;&#10;WHEN &apos;Last 30 days&apos; then [event_date]&gt; DATEADD(&apos;day&apos;, -30, [Calculation_0860095029850115])&#13;&#10;ELSE TRUE&#13;&#10;END' />
            </column>
            <column caption='Event Week' datatype='datetime' name='[Calculation_0860095119265802]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [event_date])' />
            </column>
            <column caption='Event Date' datatype='date' name='[event_date]' role='dimension' type='ordinal' />
            <column caption='Event Type' datatype='string' name='[event_type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0860095030267908]' derivation='None' name='[none:Calculation_0860095030267908:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0860095119265802]' derivation='None' name='[none:Calculation_0860095119265802:ok]' pivot='key' type='ordinal' />
            <column-instance column='[event_type]' derivation='None' name='[none:event_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' />
            <column-instance column='[vehicle_type]' derivation='None' name='[none:vehicle_type:nk]' pivot='key' type='nominal' />
            <column caption='Status' datatype='string' name='[status]' role='dimension' type='nominal' />
            <column-instance column='[trip_miles]' derivation='Sum' name='[sum:trip_miles:qk]' pivot='key' type='quantitative' />
            <column caption='Trip Miles' datatype='real' default-format='n#,##0;-#,##0' name='[trip_miles]' role='measure' type='quantitative' />
            <column caption='Vehicle Type' datatype='string' name='[vehicle_type]' role='dimension' type='nominal' />
            <column-instance column='[event_date]' derivation='Weekday' name='[wd:event_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0ieta591od6l6310zs0tm09nx7go].[none:Calculation_0860095030267908:nk]' filter-group='3'>
            <groupfilter function='member' level='[none:Calculation_0860095030267908:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <natural-sort column='[federated.0ieta591od6l6310zs0tm09nx7go].[none:Calculation_0860095119265802:ok]' direction='DESC' />
          <filter class='categorical' column='[federated.0ieta591od6l6310zs0tm09nx7go].[none:event_type:nk]'>
