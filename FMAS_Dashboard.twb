    <worksheet name='Driver Podium'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#14213d' fontsize='13'>Who drives the most?</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#8a94a3' fontsize='9'>Top 3 drivers by miles driven</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='v_fleet_activity (fleet_management)' name='federated.0ieta591od6l6310zs0tm09nx7go' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Window' datatype='string' name='[Parameter 0860095027589120]' param-domain-type='list' role='measure' type='nominal' value='&quot;Last 7 days&quot;'>
              <calculation class='tableau' formula='&quot;Last 7 days&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ieta591od6l6310zs0tm09nx7go'>
            <column caption='Latest Date' datatype='date' name='[Calculation_0860095029850115]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX([event_date]) }' />
            </column>
            <column caption='In window' datatype='boolean' name='[Calculation_0860095030267908]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 0860095027589120]&#13;&#10;WHEN &apos;Latest day&apos; THEN [event_date] = [Calculation_0860095029850115]&#13;&#10;WHEN &apos;Last 7 days&apos; THEN [event_date] &gt; DATEADD(&apos;day&apos;, -7, [Calculation_0860095029850115])&#13;&#10;WHEN &apos;Last 30 days&apos; then [event_date]&gt; DATEADD(&apos;day&apos;, -30, [Calculation_0860095029850115])&#13;&#10;ELSE TRUE&#13;&#10;END' />
            </column>
            <column caption='Podium Rank' datatype='integer' name='[Calculation_1711942131277828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE(SUM([trip_miles]))'>
