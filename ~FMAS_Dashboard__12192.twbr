          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Window' datatype='string' name='[Parameter 0860095027589120]' param-domain-type='list' role='measure' type='nominal' value='&quot;Last 30 days&quot;'>
              <calculation class='tableau' formula='&quot;Last 30 days&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ieta591od6l6310zs0tm09nx7go'>
            <column caption='Latest Date' datatype='date' name='[Calculation_0860095029850115]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX([event_date]) }' />
            </column>
            <column caption='In window' datatype='boolean' name='[Calculation_0860095030267908]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 0860095027589120]&#13;&#10;WHEN &apos;Latest day&apos; THEN [event_date] = [Calculation_0860095029850115]&#13;&#10;WHEN &apos;Last 7 days&apos; THEN [event_date] &gt; DATEADD(&apos;day&apos;, -7, [Calculation_0860095029850115])&#13;&#10;WHEN &apos;Last 30 days&apos; then [event_date]&gt; DATEADD(&apos;day&apos;, -30, [Calculation_0860095029850115])&#13;&#10;ELSE TRUE&#13;&#10;END' />
            </column>
            <column caption='Total Cost' datatype='real' default-format='C1033%' name='[Calculation_0860095032778758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[fuel_cost] + [maintenance_cost]' />
            </column>
            <column caption='Active Vehicles' datatype='integer' name='[Calculation_0860095033012231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [status] = &apos;ACTIVE&apos; THEN [vehicle_code] END)' />
            </column>
            <column caption='Fleet MPG' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_0860095033303048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([trip_miles])/SUM([gallons])' />
            </column>
            <column caption='Cost per Mile' datatype='real' default-format='C1033%' name='[Calculation_0860095033524233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([fuel_cost]) + SUM([maintenance_cost]))/SUM([trip_miles])' />
            </column>
            <column caption='MPG Change %' datatype='real' name='[Calculation_0860095120248846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_0860095033303048]-[Calculation_1711941816381441])/[Calculation_1711941816381441]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MPG Baseline' datatype='real' name='[Calculation_1711941816381441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG([Calculation_0860095033303048], -8, -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
