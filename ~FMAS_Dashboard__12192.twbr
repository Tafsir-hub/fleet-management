      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0ieta591od6l6310zs0tm09nx7go].[sum:fuel_cost:qk]&quot;' value='FUEL COST' />
          <alias key='&quot;[federated.0ieta591od6l6310zs0tm09nx7go].[sum:maintenance_cost:qk]&quot;' value='MAINTENANCE' />
          <alias key='&quot;[federated.0ieta591od6l6310zs0tm09nx7go].[sum:trip_miles:qk]&quot;' value='MILES DRIVEN' />
          <alias key='&quot;[federated.0ieta591od6l6310zs0tm09nx7go].[usr:Calculation_0860095033012231:qk]&quot;' value='ACTIVE VEHICLES' />
          <alias key='&quot;[federated.0ieta591od6l6310zs0tm09nx7go].[usr:Calculation_0860095033303048:qk]&quot;' value='FLEET MPG' />
          <alias key='&quot;[federated.0ieta591od6l6310zs0tm09nx7go].[usr:Calculation_0860095033524233:qk]&quot;' value='COST PER MILE' />
        </aliases>
      </column>
      <column caption='Medal Order' datatype='integer' name='[Calculation_0837830509449217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Calculation_1711942131277828] WHEN 1 THEN 1 WHEN 2 THEN 2 WHEN 3 THEN 3 END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Latest Date' datatype='date' name='[Calculation_0860095029850115]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([event_date]) }' />
      </column>
      <column caption='In window' datatype='boolean' name='[Calculation_0860095030267908]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0860095027589120]&#13;&#10;WHEN &apos;Latest day&apos; THEN [event_date] = [Calculation_0860095029850115]&#13;&#10;WHEN &apos;Last 7 days&apos; THEN [event_date] &gt; DATEADD(&apos;day&apos;, -7, [Calculation_0860095029850115])&#13;&#10;WHEN &apos;Last 30 days&apos; then [event_date]&gt; DATEADD(&apos;day&apos;, -30, [Calculation_0860095029850115])&#13;&#10;ELSE TRUE&#13;&#10;END' />
      </column>
      <column caption='Period' datatype='datetime' name='[Calculation_0860095031808005]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0860095028883457]&#13;&#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [event_date])&#13;&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,  [event_date])&#13;&#10;ELSE DATETRUNC(&apos;month&apos;, [event_date])&#13;&#10;END' />
      </column>
      <column caption='Total Cost' datatype='real' default-format='C1033%' name='[Calculation_0860095032778758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[fuel_cost] + [maintenance_cost]' />
      </column>
      <column caption='Active Vehicles' datatype='integer' name='[Calculation_0860095033012231]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [status] = &apos;ACTIVE&apos; THEN [vehicle_code] END)' />
      </column>
      <column caption='Fleet MPG' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_0860095033303048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([trip_miles])/SUM([gallons])' />
      </column>
      <column caption='Cost per Mile' datatype='real' default-format='C1033%' name='[Calculation_0860095033524233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([fuel_cost]) + SUM([maintenance_cost]))/SUM([trip_miles])' />
      </column>
      <column caption='Event Week' datatype='datetime' name='[Calculation_0860095119265802]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [event_date])' />
      </column>
      <column caption='Top N Fuel' datatype='boolean' name='[Calculation_0860095119462411]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM([fuel_cost]))&lt;= [Parameters].[Parameter 0860095029424130]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top N Maintenance' datatype='boolean' name='[Calculation_0860095119753228]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM([maintenance_cost])) &lt;= [Parameters].[Parameter 0860095029424130]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top N Miles' datatype='boolean' name='[Calculation_0860095120064525]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM([trip_miles])) &lt;= [Parameters].[Parameter 0860095029424130]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MPG Change %' datatype='real' name='[Calculation_0860095120248846]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_0860095033303048]-[Calculation_1711941816381441])/[Calculation_1711941816381441]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MPG Alert' datatype='string' name='[Calculation_0860095121473551]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ABS([Calculation_0860095120248846]) &gt;= 0.25 THEN &apos;Unusual&apos; &#13;&#10;ELSE &apos;Normal&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Last 12 weeks' datatype='boolean' name='[Calculation_0860095121936400]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LOOKUP(MAX([Calculation_0860095119265802]), 0) &gt;= DATEADD(&apos;week&apos;, -10, DATETRUNC(&apos;week&apos;, MAX([Calculation_0860095029850115])))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Vehicle Label' datatype='string' name='[Calculation_1711941793247232]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vehicle_code] + &quot; . &quot; + [make_model]' />
      </column>
      <column caption='MPG Baseline' datatype='real' name='[Calculation_1711941816381441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_0860095033303048], -8, -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cost Flag' datatype='string' name='[Calculation_1711941847179267]' role='measure' type='nominal'>
